# ==========================================
# SiteAudit Pro - Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.mhjgzto.mongodb.net/siteaudit_pro?retryWrites=true&w=majority
JWT_SECRET=siteaudit-pro-super-secure-secret-key-2025
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Crawl Limits by Tier
DEFAULT_FREE_CRAWL_LIMIT=10
DEFAULT_PRO_CRAWL_LIMIT=100
DEFAULT_AGENCY_CRAWL_LIMIT=500

# External APIs (Optional)
GOOGLE_PAGESPEED_API_KEY=

# Payment Integrations (Configurable when ready for live payments)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email / SMTP Notifications (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

